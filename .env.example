# App. Docker Compose uses the PostgreSQL service below; local development can use SQLite.
POSTGRES_DB=tailormail
POSTGRES_USER=tailormail
POSTGRES_PASSWORD=replace-with-a-long-random-password
DATABASE_URL=postgresql+psycopg://tailormail:replace-with-a-long-random-password@db:5432/tailormail
APP_SECRET=replace-with-a-long-random-value
ENCRYPTION_KEY=generate-a-fernet-key-for-tenant-secrets
ENVIRONMENT=development
# Set both in production. Browser sends require this account.
ADMIN_USERNAME=
ADMIN_PASSWORD=
# Comma-separated hostnames for the deployed service.
ALLOWED_HOSTS=localhost,127.0.0.1
ARTIFACT_DIR=./artifacts
BASE_URL=http://127.0.0.1:31415
API_KEY=
LLM_MODEL=local-model

# Email. Leave blank to run safely in preview mode.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_USE_TLS=true

# Resend is used when both values are set; it takes precedence over SMTP.
RESEND_API_KEY=
RESEND_FROM=

# UK company discovery. Uses the free Companies House REST API, DuckDuckGo, and public websites.
COMPANIES_HOUSE_API_KEY=

# Daily batch worker. Set AUTO_SEND=true only after reviewing the batch locally.
OUTREACH_CANDIDATE_ID=0
OUTREACH_QUERY=
OUTREACH_TARGET_ROLE=
OUTREACH_DAILY_LIMIT=100
OUTREACH_AUTO_SEND=false
OUTREACH_TIMEZONE=Asia/Dhaka
TRIAL_DAYS=15
TRIAL_CARD_REQUIRED=false
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PUBLISHABLE_KEY=
REDIS_URL=redis://redis:6379/0
SIGNUP_ENABLED=true
